# ──────────────────────────────────────────────
# ORM Backend — Production Environment Variables
# Copy to .env on the server: cp .env.production.example .env
# Then fill in the real values below.
# ──────────────────────────────────────────────

# ── App ────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_to_a_64_char_random_string

# ── Database ───────────────────────────────────
# SQLite (simple, single-server):
DATABASE_URL=sqlite:////var/www/orm/backend/data/orm.db

# PostgreSQL (if you upgrade later):
# DATABASE_URL=postgresql+asyncpg://orm_user:password@localhost:5432/orm_db

# ── CORS ───────────────────────────────────────
CORS_ORIGINS=https://orm.brandthink.in

# ── JWT ────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_to_another_64_char_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── WhatsApp / Twilio ──────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=whatsapp:+14155238886
# Production: TWILIO_FROM_NUMBER=whatsapp:+91XXXXXXXXXX

# ── YouTube Sync (optional) ────────────────────
YOUTUBE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXX

# ── Email (optional SMTP alerts) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@thebrandthink.com
SMTP_PASSWORD=app_specific_password_here

# ── OpenSearch / Elasticsearch (optional) ──────
# OPENSEARCH_URL=http://localhost:9200

# ── Ollama (optional AI enrichment) ────────────
# OLLAMA_URL=http://localhost:11434
