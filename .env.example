# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://orm_user:orm_pass@postgres:5432/orm_db
POSTGRES_USER=orm_user
POSTGRES_PASSWORD=orm_pass
POSTGRES_DB=orm_db

# Redis
REDIS_URL=redis://redis:6379/0

# OpenSearch
OPENSEARCH_HOST=http://opensearch:9200

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=orm-files

# JWT
JWT_SECRET=change-me-32-chars-minimum-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_FALLBACK_MODEL=mistral

# Frontend  (nginx is published on host port 8080 to avoid clashing with local Apache on 80)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
